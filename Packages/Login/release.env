# =============================================================================
# Login 套件生产打包配置（复制为 release.env 后修改）
# 用法: ./scripts/build-release.sh --config release.env
# =============================================================================

# --- 公网 HTTPS 地址（不要尾部斜杠）---
SSO_PUBLIC_URL=https://sso.znewbie.com
LOGIN_PUBLIC_URL=https://auth.znewbie.com
ADMIN_PUBLIC_URL=https://admin.znewbie.com

# --- 可选：OAuth scope / 存储前缀 ---
LOGIN_SCOPE="openid profile email"
LOGIN_STORAGE_PREFIX=verita_

# --- Go 二进制目标平台（默认 Linux 服务器）---
GOOS=linux
GOARCH=amd64

# --- 版本号（留空则由脚本自动生成，如 20250701-a1b2c3d）---
# RELEASE_VERSION=1.0.0
