# unit-auth IdP API — 反代到本机 :8080
# 部署: sudo ln -s .../sso-api.conf /etc/nginx/sites-enabled/
# 替换 YOUR_DOMAIN 与证书路径

upstream unit_auth {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name sso.YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/sso.YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sso.YOUR_DOMAIN/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://unit_auth;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

server {
    listen 80;
    server_name sso.YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}
