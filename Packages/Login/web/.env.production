# SSO服务器配置 - 直接指向unit-auth后端
VITE_SSO_SERVER_URL=https://sso.znewbie.com
VITE_SSO_REDIRECT_URI=https://auth.znewbie.com

# # 认证范围
# VITE_SSO_SCOPE=openid profile email

# 存储配置
VITE_SSO_STORAGE_TYPE=localStorage
VITE_SSO_STORAGE_PREFIX=verita_

# 功能开关
# VITE_SSO_AUTO_REFRESH=true
# VITE_SSO_REMEMBER_ME=true
# VITE_SSO_SESSION_TIMEOUT=3600

# # 开发配置
# VITE_SSO_DEV_MOCK_LOGIN=false

# 头像 CDN（可选 fallback；展示 URL 由后端 avatar_url 提供）
# VITE_FILE_CDN_BASE=
# VITE_AVATAR_CDN_BASE=