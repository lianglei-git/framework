# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=unit_auth

# JWT 签名密钥
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---------- Token 时效（统一配置，修改后重启 unit-auth）----------
# Access Token：JWT exp 与 API expires_in 的唯一入口（分钟）
ACCESS_TOKEN_EXPIRATION_MINUTES=15
# 兼容旧变量（小时）；仅当未设置 ACCESS_TOKEN_EXPIRATION_MINUTES 时生效
# JWT_EXPIRATION=24

# Refresh Token（小时），默认 720 = 30 天
JWT_REFRESH_EXPIRATION_HOURS=720
# 兼容旧名：JWT_REFRESH_EXPIRATION=720

# 「记住我」Access Token（小时），默认 720 = 30 天
JWT_REMEMBER_ME_EXPIRATION_HOURS=720
# 兼容旧名：JWT_REMEMBER_ME_EXPIRATION=720

# IdP sso_sessions / session cookie（天）
SSO_SESSION_EXPIRATION_DAYS=365

# OAuth 授权码（分钟）
AUTH_CODE_EXPIRATION_MINUTES=10

# Session 清理：超过该天数不活跃则删除（天）
SSO_MAX_INACTIVE_DAYS=90

# RSA密钥配置（用于OAuth 2.0/OpenID Connect）
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# OAuth 2.0配置
OAUTH_ISSUER=https://sso.yourcompany.com
OAUTH_AUTHORIZATION_ENDPOINT=/oauth/authorize
OAUTH_TOKEN_ENDPOINT=/oauth/token
OAUTH_USERINFO_ENDPOINT=/oauth/userinfo
OAUTH_REVOCATION_ENDPOINT=/oauth/revoke
OAUTH_INTROSPECTION_ENDPOINT=/oauth/introspect

# 默认SSO客户端配置
SSO_CLIENT_ID=default-client
SSO_CLIENT_SECRET=default-client-secret

# SMTP邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth配置
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://sso.yourcompany.com/api/v1/auth/oauth/google/callback

# GitHub OAuth配置
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://sso.yourcompany.com/api/v1/auth/oauth/github/callback

# 微信 OAuth（网站应用扫码登录）
# 登录页 3033 点击「微信登录」时，redirect_uri 由前端传入；此处为兜底默认值
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
# 开发：与 web/.env 中 VITE_SSO_REDIRECT_URI 一致，如 http://localhost:3033
# 生产：填写已备案域名，微信开放平台「授权回调域」只填域名不含路径
WECHAT_REDIRECT_URI=http://localhost:3033

# 子项目 SSO：未登录时 authorize 重定向到登录页
LOGIN_WEB_URL=http://localhost:3033

# Redis配置（用于缓存和限流）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务器配置
PORT=8080
HOST=0.0.0.0
GIN_MODE=debug

# 限流配置
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m
# 本地开发：BFF 代理请求均来自 127.0.0.1，跳过回环限流（生产请设为 false）
RATE_LIMIT_SKIP_LOCALHOST=true

# 监控配置
PROMETHEUS_ENABLED=true

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 缓存配置
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# 会话配置
SESSION_TIMEOUT=3600
SESSION_AUTO_REFRESH=true

# 默认管理员（仅首次种子 / 弱口令自动升级时使用；生产请登录后立即修改）
ADMIN_USERNAME=zayne
ADMIN_INITIAL_PASSWORD=Sparrow@Admin2026 